{
  "name": "tracelog-api",
  "target": "ESNext",
  "module": "ESNext",
  "moduleResolution": "bundler",
  "scripts": {
    "dev": "wrangler dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "act:event": "act pull_request -e seeds/event.json --network host -P ubuntu-latest=catthehacker/ubuntu:act-latest -s API_URL=http://localhost:8787/api/webhooks/github/sync"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260130.0",
    "@types/bun": "latest",
    "drizzle-kit": "0.31.8",
    "wrangler": "4.59.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@libsql/client": "0.17.0",
    "better-auth": "^1.4.17",
    "drizzle-orm": "0.45.1",
    "hono": "4.11.4",
    "http-problem-details": "^0.1.7",
    "neverthrow": "^8.2.0",
    "stoker": "^2.0.1",
    "ulid": "3.0.2",
    "zod": "4.3.5"
  }
}